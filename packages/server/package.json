{
  "name": "@nonepwd/server",
  "version": "0.1.0",
  "description": "Self-hosted zero-knowledge vault server with SQLite, WebSocket live OTP relay, IMAP IDLE, Cloudflare Email webhook, Web UI, and MV3 extension bundle.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nonepwd-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "web-dist",
    "bin-dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/prepare-assets.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@nonepwd/core": "workspace:*",
    "hono": "^4.7.5",
    "imapflow": "^1.0.180",
    "postal-mime": "^2.4.7",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
