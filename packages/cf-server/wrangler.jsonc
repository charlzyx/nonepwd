{
  "name": "nonepwd-cf-server",
  "main": "dist/index.js",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "build": {
    "command": "pnpm --filter @nonepwd/web build && pnpm run build"
  },
  // 部署后可在 Cloudflare Dashboard 绑定自有域名，或取消下方注释启用 custom_domain
  // "routes": [
  //   { "pattern": "vault.yourdomain.com", "custom_domain": true }
  // ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/install.sh", "/downloads/*", "/llms.txt", "/SKILL.md", "/skill.md"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nonepwd-db"
      // 使用 Deploy to Cloudflare 会自动创建 D1；手动部署请执行 `npx wrangler d1 create nonepwd-db` 并填入 database_id
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "nonepwd-vault-blobs"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WS_HUB",
        "class_name": "VaultWsHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VaultWsHub"]
    }
  ],
  // Optional Cron trigger if the Cloudflare account has free Cron slots available.
  // Activity-triggered waitUntil(maybeAutoSnapshot) still backs up D1 -> R2 every 6 hours.
  // "triggers": { "crons": ["0 */6 * * *"] },
  "vars": {
    "FORWARD_TO_EMAIL": ""
  }
}
