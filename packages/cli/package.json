{
  "name": "@nonepwd/cli",
  "version": "0.1.0",
  "description": "Zero-knowledge np / nonepwd CLI, secret injector, live Email OTP waiter, and Connect HTTP API gateway.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "np": "./dist/bin.js",
    "nonepwd": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
