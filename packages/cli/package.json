    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nonepwd/core": "workspace:*",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
