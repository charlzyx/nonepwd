{
  "name": "NonePwd",
  "id": "dev.nonepwd.app",
  "version": "0.1.0",
  "build": 7,
  "theme": {
    "cssVars": {
      "theme": {
        "radius": "12px"
      },
      "light": {
        "background": "#f4f4f6",
        "foreground": "#18181b",
        "card": "#ffffff",
        "card-foreground": "#18181b",
        "popover": "#ffffff",
        "popover-foreground": "#18181b",
        "primary": "#24364d",
        "primary-foreground": "#ffffff",
        "secondary": "#e7e8ec",
        "secondary-foreground": "#18181b",
        "muted": "#e8e9ed",
        "muted-foreground": "#686b73",
        "accent": "#eceef2",
        "accent-foreground": "#18181b",
        "destructive": "#c93b3b",
        "border": "#e4e5e9",
        "input": "#f0f1f4",
        "ring": "#24364d",
        "chart-1": "#24364d",
        "chart-2": "#1f7a55",
        "chart-3": "#b4691e",
        "chart-4": "#525866",
        "chart-5": "#2d6480"
      },
      "dark": {
        "background": "#0f1115",
        "foreground": "#f2f3f5",
        "card": "#181a20",
        "card-foreground": "#f2f3f5",
        "popover": "#181a20",
        "popover-foreground": "#f2f3f5",
        "primary": "#5a7aa3",
        "primary-foreground": "#ffffff",
        "secondary": "#252830",
        "secondary-foreground": "#f2f3f5",
        "muted": "#252830",
        "muted-foreground": "#9498a1",
        "accent": "#252830",
        "accent-foreground": "#f2f3f5",
        "destructive": "#d65353",
        "border": "#282b34",
        "input": "#21242c",
        "ring": "#5a7aa3",
        "chart-1": "#5a7aa3",
        "chart-2": "#3ba379",
        "chart-3": "#d48b3b",
        "chart-4": "#8b92a2",
        "chart-5": "#4d8db0"
      }
    }
  },
  "capabilities": {
    "network": {
      "hosts": ["*"]
    },
    "clipboard": true,
    "picker": true,
    "webview": {
      "hosts": ["*"]
    },
    "statusBar": true,
    "openUrl": {
      "schemes": ["https", "http"]
    },
    "host": [
      "autofill.status",
      "autofill.enable",
      "autofill.sync",
      "autofill.takePendingSaves"
    ]
  }
}
